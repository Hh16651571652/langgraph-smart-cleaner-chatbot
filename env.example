# ============================================
# 环境变量配置示例
# 使用方法：复制此文件为 .env，并填入真实的API密钥
# ============================================

# LangSmith API Key（用于追踪和监控）
# 获取方式：https://smith.langchain.com/
LANGCHAIN_API_KEY="your-langchain-api-key-here"

# 通义千问 API Key（阿里云百炼）
# 获取方式：https://dashscope.console.aliyun.com/
QIANWEN_API_KEY="your-qianwen-api-key-here"

# MCP 服务器配置
MCP_SERVER_URL="https://dashscope.aliyuncs.com/api/v1/mcps/mcp-M2UzYzE5MmMyYzIy/mcp"
MCP_API_KEY="your-mcp-api-key-here"

# ============================================
# 安全提示：
# 1. 不要将 .env 文件提交到版本控制系统
# 2. 确保 .env 已添加到 .gitignore
# 3. 定期更换API密钥
# ============================================
